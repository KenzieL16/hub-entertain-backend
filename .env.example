NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hub-entertain

# JWT (ganti dengan string acak panjang, contoh: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Frontend origin(s) yang diizinkan CORS, pisahkan dengan koma
CLIENT_URL=http://localhost:5173

# Password untuk akun demo yang dibuat oleh `npm run seed`
SEED_DEMO_PASSWORD=Password123
